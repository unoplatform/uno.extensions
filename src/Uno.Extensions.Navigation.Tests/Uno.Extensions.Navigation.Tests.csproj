<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<!--
		  Uno.Extensions.Navigation.WinUI has a module initializer that needs Uno.UI at run time. The central
		  Uno.WinUI version is $(UnoVersion), which only Uno.Sdk defines; without it transitive pinning drops
		  Uno.WinUI from this plain test host. Take it from the Uno.Sdk.Private pin in global.json instead.
		-->
		<UnoVersion Condition="'$(UnoVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\global.json')), '(?s).*"Uno\.Sdk\.Private"\s*:\s*"([^"]+)".*', '$1'))</UnoVersion>
		<!-- The tests load Navigation types but never start the Uno runtime, so no runtime host package is needed. -->
		<UnoDisableUNOB0025Validation>true</UnoDisableUNOB0025Validation>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>obj/g</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Moq" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Navigation\Uno.Extensions.Navigation.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Navigation.UI\Uno.Extensions.Navigation.WinUI.csproj" />
	</ItemGroup>
</Project>
