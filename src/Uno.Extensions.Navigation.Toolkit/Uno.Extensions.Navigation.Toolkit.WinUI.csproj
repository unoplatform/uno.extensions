<Project Sdk="Uno.Sdk">
	<Import Project="..\tfms-ui-winui.props" />

	<PropertyGroup>
		<AssemblyName>Uno.Extensions.Navigation.Toolkit.UI</AssemblyName>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
		<!--Temporary disable missing XML doc until fixed in the whole package-->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>

		<Description>Navigation Extensions for working with the Uno Toolkit on the Uno Platform (WinUI)</Description>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>

		<UnoSingleProject>true</UnoSingleProject>
		<OutputType>Library</OutputType>
		
		<PackageId>Uno.Extensions.Navigation.Toolkit.WinUI</PackageId>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>

		<UnoFeatures>
			Toolkit;
		</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="LinkerDefinition.xml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Navigation.UI\Uno.Extensions.Navigation.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Core.UI\Uno.Extensions.Core.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Core\Uno.Extensions.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Uno.Core.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="LinkerDefinition.xml">
			<LogicalName>$(AssemblyName).xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
		<Compile Update="**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<UpToDateCheckInput Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(TargetFramework)'=='net9.0-ios' or '$(TargetFramework)'=='net9.0-android'">
			<ItemGroup>
				<IncludeXamlNamespaces Include="mobile" />
				<ExcludeXamlNamespaces Include="not_mobile" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<IncludeXamlNamespaces Include="not_mobile" />
				<ExcludeXamlNamespaces Include="mobile" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<!-- Uno's XAML generator treats Mac Catalyst as `ios` (Uno.UI.SourceGenerators.props), but
		Uno.Toolkit ships no catalyst assembly since 8.5 and its plain netX.0 lib has no
		NativeFramePresenter, which Controls/ModalFlyout.xaml only uses inside an <ios:> template.
		Catalyst takes the not_mobile template (above), so that resource is dropped there. A target
		rather than a plain ItemGroup: Uno adds its Include/ExcludeXamlNamespaces items after this
		project body is evaluated, and the generator lets an include win over an exclude, so the
		removal has to run before Uno turns the items into properties. -->
	<Target Name="_UnoExtensionsDropIosXamlOnCatalyst"
			BeforeTargets="_FillSourceGeneratorItemGroups"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='maccatalyst'">
		<ItemGroup>
			<IncludeXamlNamespaces Remove="ios" />
			<ExcludeXamlNamespaces Include="ios" />
		</ItemGroup>
	</Target>
</Project>
