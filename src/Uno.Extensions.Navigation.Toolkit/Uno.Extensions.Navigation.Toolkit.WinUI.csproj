<Project Sdk="Uno.Sdk">
	<!--
		This package ships no Mac Catalyst TFM. Controls/ModalFlyout.xaml uses
		utu:NativeFramePresenter inside an <ios:ControlTemplate>, and Uno's `ios` conditional XAML
		namespace also matches Mac Catalyst - but Uno.Toolkit stopped shipping a maccatalyst assembly
		at 8.5.0-dev.29 and still does not in stable 9.x, so catalyst resolves the plain net9.0 Toolkit
		flavor, which does not contain that type (UXAML0001 plus five cascading generator errors).
		Catalyst consumers fall back to this package's own net9.0 TFM, where the `not_mobile` template
		applies - the same presentation the desktop template already gives them.

		Set before the tfms import so the condition in there sees it. Note that a global
		-p:Build_MacCatalyst=true would override this and re-break the build.
	-->
	<PropertyGroup>
		<Build_MacCatalyst>false</Build_MacCatalyst>
	</PropertyGroup>

	<Import Project="..\tfms-ui-winui.props" />

	<PropertyGroup>
		<AssemblyName>Uno.Extensions.Navigation.Toolkit.UI</AssemblyName>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
		<!--Temporary disable missing XML doc until fixed in the whole package-->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>

		<Description>Navigation Extensions for working with the Uno Toolkit on the Uno Platform (WinUI)</Description>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>

		<UnoSingleProject>true</UnoSingleProject>
		<OutputType>Library</OutputType>
		
		<PackageId>Uno.Extensions.Navigation.Toolkit.WinUI</PackageId>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>

		<UnoFeatures>
			Toolkit;
		</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="LinkerDefinition.xml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Navigation.UI\Uno.Extensions.Navigation.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Core.UI\Uno.Extensions.Core.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Core\Uno.Extensions.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Uno.Core.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="LinkerDefinition.xml">
			<LogicalName>$(AssemblyName).xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
		<Compile Update="**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<UpToDateCheckInput Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(TargetFramework)'=='net9.0-ios' or '$(TargetFramework)'=='net9.0-android'">
			<ItemGroup>
				<IncludeXamlNamespaces Include="mobile" />
				<ExcludeXamlNamespaces Include="not_mobile" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<IncludeXamlNamespaces Include="not_mobile" />
				<ExcludeXamlNamespaces Include="mobile" />
			</ItemGroup>
		</Otherwise>
	</Choose>
</Project>
