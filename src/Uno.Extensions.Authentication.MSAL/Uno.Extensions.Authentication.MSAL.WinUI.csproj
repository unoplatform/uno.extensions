<Project Sdk="Uno.Sdk">
	<Import Project="..\tfms-ui-winui.props" />

	<PropertyGroup>
		<PackageId>Uno.Extensions.Authentication.MSAL.WinUI</PackageId>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>
		<IsAotCompatible>true</IsAotCompatible>

		<Description>MSAL Authentication Extensions for the Uno Platform (WinUI)</Description>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>

		<!--<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>-->

		<UnoSingleProject>true</UnoSingleProject>
		<OutputType>Library</OutputType>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup >
		<!-- MSAL isn't supported on skia targets, macos or maccatalyst -->
		<PackageReference Include="Uno.WinUI" />
		<PackageReference Include="Uno.WinUI.MSAL" />
	</ItemGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('windows10'))">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.ToLower().StartsWith('net6')) and $(_IsAndroid)">
		<SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>31.0</TargetPlatformMinVersion>
		<TargetPlatformVersion>31.0</TargetPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.ToLower().StartsWith('net6')) and $(_IsIOS)">
		<SupportedOSPlatformVersion>14.2</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>14.2</TargetPlatformMinVersion>
		<TargetPlatformVersion>15.4</TargetPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.ToLower().StartsWith('net6')) and $(_IsCatalyst)">
		<SupportedOSPlatformVersion>14.2</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>14.2</TargetPlatformMinVersion>
		<TargetPlatformVersion>15.4</TargetPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Http.UI\Uno.Extensions.Http.WinUI.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!--Temporary disable missing XML doc until fixed in the whole package-->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
	</PropertyGroup>

	<!-- Define UNO_EXT_MSAL only for the platforms that ship a functional provider (the plain
		.NET reference lib, macOS and Mac Catalyst carry a no-op stub). Keep this allow-list in
		sync with build/Package.targets, which applies the same rule in consuming projects. -->
	<PropertyGroup>
		<_UnoExtMsalTargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_UnoExtMsalTargetPlatform>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_UnoExtMsalTargetPlatform)'=='android' or '$(_UnoExtMsalTargetPlatform)'=='ios' or '$(_UnoExtMsalTargetPlatform)'=='windows' or '$(_UnoExtMsalTargetPlatform)'=='desktop' or '$(_UnoExtMsalTargetPlatform)'=='browserwasm'">
		<DefineConstants>$(DefineConstants);UNO_EXT_MSAL</DefineConstants>
	</PropertyGroup>

	<!-- TFM markers derived from the target platform itself, used only to cross-check that the
		SDK's implicit ANDROID / IOS symbols are actually defined - see the #error guards in
		MsalAuthenticationProvider.cs. Without this, a platform branch that silently stops
		compiling degrades to the desktop path with no build error and no test failure. -->
	<PropertyGroup Condition="'$(_UnoExtMsalTargetPlatform)'=='android'">
		<DefineConstants>$(DefineConstants);UNO_EXT_MSAL_ANDROID_TFM</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_UnoExtMsalTargetPlatform)'=='ios'">
		<DefineConstants>$(DefineConstants);UNO_EXT_MSAL_IOS_TFM</DefineConstants>
	</PropertyGroup>

	<!-- Token-cache persistence isn't available in the browser; compiling it out keeps the
		unused MsalCacheHelper code paths out of the WebAssembly assembly. -->
	<PropertyGroup Condition="'$(_UnoExtMsalTargetPlatform)'=='browserwasm'">
		<DefineConstants>$(DefineConstants);UNO_EXT_MSAL_NOSTORAGE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Core\Uno.Extensions.Core.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Configuration\Uno.Extensions.Configuration.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Hosting\Uno.Extensions.Hosting.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Authentication\Uno.Extensions.Authentication.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
		<PackageReference Include="Microsoft.Identity.Client" />
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('windows10'))">
		<PackageReference Include="Microsoft.Identity.Client.Broker" />
	</ItemGroup>

	<ItemGroup>
		<Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
		<Compile Update="**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<UpToDateCheckInput Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
	</ItemGroup>
</Project>
