<Project Sdk="Uno.Sdk.Private">
  <Import Project="..\..\tfms-ui-winui.props" />

	<PropertyGroup>
		<Description>Internal core project that could be used by runtime tests projects</Description>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>
		<DefineConstants Condition="'$(_IsWinUI)'=='true'">$(DefineConstants);WINDOWS_WINUI</DefineConstants>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);Uno0001</WarningsNotAsErrors>
	</PropertyGroup>

	<!--
		Uno.UI.RuntimeTests.Engine compiles from source and guards its Console.CancelKeyPress
		registration - unsupported in the browser - with `#if !__WASM__`. Uno.Sdk stopped defining
		__WASM__ for consumer projects, so without this the WebAssembly runtime-test head throws
		PlatformNotSupportedException before the first test runs (build 228808). The symbol also switches
		on branches that call WebAssemblyRuntime.InvokeJS, which WebAssemblyRuntimeShim.cs supplies.
		Remove both once the engine uses a runtime check instead.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
		<DefineConstants>$(DefineConstants);__WASM__</DefineConstants>
		<!-- The JS interop generator emits unsafe marshalling code (SYSLIB1074). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<!--<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>-->

    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Threading.Tasks.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Uno.UI.RuntimeTests.Engine" />
		<PackageReference Include="Uno.UI.Adapter.Microsoft.Extensions.Logging" />
		<!-- Required for hot-reload tests ([RunsInSecondaryApp]) - enables HAS_UNO_DEVSERVER in the RuntimeTests.Engine.
		     Debug-only: in Release the DevServer assembly is not published and would cause a FileNotFoundException. -->
		<PackageReference Include="Uno.WinUI.DevServer" PrivateAssets="all" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>
</Project>
