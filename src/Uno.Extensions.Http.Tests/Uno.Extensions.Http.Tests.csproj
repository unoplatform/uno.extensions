<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Uno.Extensions.Http is a plain net9.0 library with no Uno.UI dependency, so the registration
    surface loads cleanly in a bare test host.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Uno.Extensions.Http\Uno.Extensions.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
