<Project Sdk="Uno.Sdk.Private">
	<Import Project="..\tfms-ui-winui-apps.props" />

	<PropertyGroup>
		<Description>Test library for the navigation extensions for the Uno Platform (WinUI)</Description>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>
		<DefineConstants>$(DefineConstants);WINUI</DefineConstants>

		<UnoSingleProject>true</UnoSingleProject>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'!='net10.0-windows10.0.19041'">
		<Content Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="FluentAssertions" />
	</ItemGroup>

	<ItemGroup>
		<Page Include="Pages\HotReloadNavRequestPage.xaml" />
		<Page Include="Pages\HotReloadRegionAttachedPage.xaml" />
		<Page Include="Pages\HotReloadRegionNavigatorPage.xaml" />
		<Page Include="Pages\HotReloadTabBarXamlPage.xaml" />
		<Page Include="Pages\HotReloadTabBarCommandPage.xaml" />
		<Page Include="Pages\HotReloadVmXamlPage.xaml" />
		<Page Include="Pages\HotReloadStrandedContentPage.xaml" />
		<Page Include="Pages\FirstPage.xaml" />
		<Page Include="Pages\HotReloadMainTabBarPage.xaml" />
		<Page Include="Pages\HotReloadNavDataBindingPage.xaml" />
		<Page Include="Pages\HotReloadPanelRegionNamesPage.xaml" />
		<Page Include="Pages\HotReloadRegionNameAddRemovePage.xaml" />
		<Page Include="Pages\HotReloadRegionRenamePage.xaml" />
		<Page Include="Pages\HotReloadTabBarLateAddPage.xaml" />
		<Page Include="Pages\SecondPage.xaml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Extensions.Navigation.UI\Uno.Extensions.Navigation.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Navigation.Toolkit\Uno.Extensions.Navigation.Toolkit.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.Hosting.UI\Uno.Extensions.Hosting.WinUI.csproj" />
		<ProjectReference Include="..\Uno.Extensions.RuntimeTests\Uno.Extensions.RuntimeTests.Core\Uno.Extensions.RuntimeTests.Core.csproj" />
	</ItemGroup>
</Project>
