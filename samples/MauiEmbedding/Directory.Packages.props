<Project ToolsVersion="15.0">
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Packages.props" />

  <ItemGroup>
    <PackageVersion Include="Syncfusion.Maui.Core" Version="22.2.9" />
    <PackageVersion Include="Syncfusion.Maui.Charts" Version="22.2.9" />
    <PackageVersion Include="Syncfusion.Maui.DataGrid" Version="22.2.9" />
    <PackageVersion Include="Telerik.UI.for.Maui" Version="5.1.0" Condition="$(_UseTelerik)" />
    <PackageVersion Include="Esri.ArcGISRuntime.Maui" Version="200.1.0" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="7.0.4" />
    <!-- MAUI's Ktx packages cap the AndroidX versions the Uno 7 SDK supplies; the newer Ktx packages are empty shells,
         whereas the old ones duplicate the classes the merged fragment and lifecycle packages now ship (D8 fails). -->
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
  </ItemGroup>
</Project>
